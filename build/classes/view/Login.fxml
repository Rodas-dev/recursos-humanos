<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="403.0" prefWidth="549.0" spacing="10" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rodasoft.recursos.humanos.controlller.LoginController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <Label text="Bienvenido!">
      <font>
         <Font size="18.0" />
      </font></Label>
    <Label text="Usuario" />
    <TextField fx:id="txtUsuario" />
    <Label text="Contraseña" />
    <PasswordField fx:id="txtContrasena" />
    <Button onAction="#onIngresar" prefHeight="31.0" prefWidth="90.0" text="Iniciar sesion" />
    <Button onAction="#onIrARegistro" prefHeight="25.0" prefWidth="91.0" text="Registrarme" />
</VBox>
